---
import "../styles/global.css";
import "lenis/dist/lenis.css";
import { site } from "../data/site";

interface Props {
	title?: string;
	description?: string;
}

const { title = site.name, description = site.description } = Astro.props;

const origin = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL("/ogp.png", origin).href;
const pageUrl = new URL("/", origin).href;

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${pageUrl}#website`,
			url: pageUrl,
			name: site.name,
			inLanguage: "ja",
			description,
			publisher: { "@id": `${pageUrl}#restaurant` },
		},
		{
			"@type": "Restaurant",
			"@id": `${pageUrl}#restaurant`,
			name: site.name,
			url: pageUrl,
			image: ogImage,
			description: site.description,
			telephone: "+81429787642",
			servesCuisine: ["ラーメン", "居酒屋"],
			priceRange: "¥",
			currenciesAccepted: "JPY",
			paymentAccepted: "現金, クレジットカード, 電子マネー, PayPay",
			smokingAllowed: true,
			acceptsReservations: true,
			hasMenu: `${pageUrl}#menu`,
			address: {
				"@type": "PostalAddress",
				postalCode: "357-0035",
				addressRegion: "埼玉県",
				addressLocality: "飯能市",
				streetAddress: "柳町23-13",
				addressCountry: "JP",
			},
			sameAs: [site.instagram],
		},
	],
};
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#1a1410" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="628" />
		<meta property="og:image:alt" content={site.name} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip" href="#top">本文へスキップ</a>
		<slot />
		<a class="callbar" href={`tel:${site.phoneTel}`}>
			<span>電話で予約</span>
			<strong>{site.phoneDisplay}</strong>
		</a>
		<script>
			import "../scripts/motion.ts";
		</script>
	</body>
</html>
