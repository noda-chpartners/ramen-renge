---
import { Image } from "astro:assets";
import logo from "../assets/fleurir-logo.webp";
import { site } from "../data/site";
---

<section class="upstairs" id="fleurir">
	<div class="upstairs__copy">
		<p class="upstairs__floor">2<small>階</small></p>
		<h2>{site.fleurirName}</h2>
		<p>同じ建物の階段を上がると、ちょい呑みの別の店です。</p>
		<a href={site.fleurirUrl} target="_blank" rel="noopener noreferrer">{site.fleurirName}へ</a>
	</div>
	<figure class="upstairs__photo upstairs__photo--logo">
		<Image src={logo} alt="スナック Fleurirのロゴ" />
	</figure>
</section>
