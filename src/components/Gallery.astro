---
import { Image } from "astro:assets";
import ramen from "../assets/line_oa_chat_261019_162318.jpg";
import salmon from "../assets/line_oa_chat_261019_162320.jpg";
import salad from "../assets/line_oa_chat_261019_162328.jpg";
import oden from "../assets/line_oa_chat_261019_162327.jpg";
import dashimaki from "../assets/line_oa_chat_261019_162330.jpg";
import interior from "../assets/line_oa_chat_261019_162336.jpg";
import board from "../assets/menu/line_oa_chat_261019_163102.jpg";
import wall from "../assets/menu/line_oa_chat_261019_163106.jpg";

const photos = [
	{ src: ramen, alt: "チャーシューと味玉の中華そば", caption: "中華そば", frame: "portrait" },
	{ src: salmon, alt: "レモンを添えたサーモンソテー", caption: "サーモンソテー", frame: "portrait" },
	{ src: salad, alt: "クルトンをのせたサラダ", caption: "サラダ", frame: "portrait" },
	{ src: oden, alt: "鍋いっぱいに煮えたおでん", caption: "おでん", frame: "portrait" },
	{ src: dashimaki, alt: "切り分けただし巻き玉子", caption: "だし巻き玉子", frame: "wide" },
	{ src: interior, alt: "明るい木のカウンター席", caption: "店内", frame: "wide" },
];

const daily = [
	{ src: board, alt: "本日のおすすめが書かれた黒板", caption: "黒板" },
	{ src: wall, alt: "本日のおすすめの貼り紙", caption: "貼り紙" },
];
---

<section class="frames" id="gallery">
	<div class="frames__grid">
		{
			photos.map((photo, index) => (
				<figure class:list={["frames__" + photo.frame, { "frames__lead": index === 0 }]}>
					<Image src={photo.src} alt={photo.alt} />
					<figcaption>{photo.caption}</figcaption>
				</figure>
			))
		}
	</div>
	<div class="chalk">
		<p>黒板は、その日の分。値段も日によって変わります。</p>
		<div class="chalk__row">
			{
				daily.map((photo) => (
					<figure>
						<Image src={photo.src} alt={photo.alt} />
						<figcaption>{photo.caption}</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>
